---
import Base from '../layouts/Base.astro';
import Reproductor from '../components/Reproductor.astro';
import MapaDecisiones from '../components/MapaDecisiones.astro';
import { curso, nodos } from '../data/escenario';

const escenas = Object.values(nodos);
const decisiones = escenas.filter((n) => n.opciones).length;
const finales = escenas.filter((n) => n.final).length;
---
<Base titulo={curso.titulo} descripcion="Demo de video de capacitación interactivo: el espectador decide el camino de la historia.">
  <header>
    <p class="eti">{curso.subtitulo}</p>
    <h1>{curso.titulo}</h1>
    <p class="intro">El video avanza y, en los momentos clave, tú eliges qué hace el trabajador. Cada decisión lleva a un camino distinto, con retroalimentación inmediata y un puntaje al final.</p>
  </header>

  <main>
    <Reproductor />

    <p class="ayuda">Usa el mouse o las teclas <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> para elegir. Si no decides a tiempo, la historia sigue con la opción por defecto.</p>

    <div class="columnas">
      <section class="tarjeta mapa">
        <h2>Mapa de decisiones</h2>
        <p class="tenue">{escenas.length} clips · {decisiones} puntos de decisión · {finales} finales posibles. Tu recorrido se ilumina mientras juegas.</p>
        <ul class="arbol"><MapaDecisiones id={curso.inicio} /></ul>
      </section>

      <section class="tarjeta">
        <h2>Qué muestra este demo</h2>
        <ul class="lista">
          <li><strong>Decisiones sobre el video</strong>: las opciones aparecen mientras la escena sigue corriendo, con cuenta regresiva.</li>
          <li><strong>Ramas y finales múltiples</strong>: aciertos y errores llevan a consecuencias distintas.</li>
          <li><strong>Retroalimentación inmediata</strong> en cada elección y una lección clave al final.</li>
          <li><strong>Puntaje y recorrido</strong> del participante, listos para enviarse a un LMS (SCORM/xAPI) o a analítica.</li>
          <li><strong>Guion editable</strong>: toda la historia vive en un solo archivo de datos; cambiar los clips por video filmado no requiere tocar el reproductor.</li>
          <li><strong>Funciona en web y celular</strong>, sin plugins ni apps.</li>
        </ul>
        <p class="tenue nota">Los clips son animaciones de muestra generadas para este demo (uso libre). En un proyecto real se sustituyen por video filmado o animado a la medida.</p>
      </section>
    </div>
  </main>

  <footer>Demo hecho con <a href="https://astro.build">Astro</a>.</footer>
</Base>

<style>
  header, main, footer { width: min(1100px, 100% - 32px); margin-inline: auto; }
  header { padding: 40px 0 24px; }
  h1 { margin: 0 0 8px; font-size: clamp(28px, 5vw, 46px); line-height: 1.1; }
  .eti { margin: 0 0 8px; text-transform: uppercase; letter-spacing: .12em; font-size: 12px; font-weight: 700; color: var(--acento); }
  .intro { margin: 0; max-width: 70ch; color: var(--tenue); font-size: 17px; }
  .ayuda { color: var(--tenue); font-size: 14px; margin: 14px 0 32px; }
  kbd { padding: 1px 6px; border: 1px solid var(--borde); border-bottom-width: 2px; border-radius: 4px; font-size: 12px; background: var(--panel); }
  .columnas { display: grid; grid-template-columns: 1.15fr 1fr; gap: 20px; align-items: start; }
  .tarjeta { background: #13161c; border: 1px solid var(--borde); border-radius: 14px; padding: 20px 22px; min-width: 0; }
  .tarjeta h2 { margin: 0 0 6px; font-size: 20px; }
  .tenue { color: var(--tenue); font-size: 14px; margin: 0 0 12px; }
  .arbol { padding: 0; margin: 0; }
  .arbol > :global(li)::before, .arbol > :global(li)::after { display: none; }
  .arbol > :global(li) { padding-left: 0; }
  .lista { padding-left: 18px; margin: 8px 0 16px; }
  .lista li { margin-bottom: 8px; color: #d4d9e1; }
  .nota { font-size: 13px; margin: 0; }
  footer { padding: 40px 0; color: var(--tenue); font-size: 13px; }
  @media (max-width: 820px) { .columnas { grid-template-columns: 1fr; } }
</style>
